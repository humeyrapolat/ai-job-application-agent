APP_NAME="AI Job Application Agent"
APP_ENV="local"
LOG_LEVEL="INFO"
CORS_ALLOW_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,https://humeyrapolat.github.io"

# Required. Protects GET /applications and GET /applications/{id} — without
# it, anyone with the deployed URL could read every stored candidate
# analysis. Send it as `Authorization: Bearer <API_KEY>`.
API_KEY="change_me_to_a_long_random_value"

LLM_PROVIDER="groq"

OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-5.6-luna"

GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"
